<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <Button
        android:id="@+id/btn_task1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="任务一：ListView + 通知"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:onClick="openTask1" />

    <Button
        android:id="@+id/btn_task2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="任务二：自定义 AlertDialog"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:onClick="openTask2" />

    <Button
        android:id="@+id/btn_task3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="任务三：菜单设置字体"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:onClick="openTask3" />

    <Button
        android:id="@+id/btn_task4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="任务四：上下文菜单(ActionMode)"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:onClick="openTask4" />

</LinearLayout>